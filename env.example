# Copiar a .env (no se commitea) y completar. Nunca poner credenciales aca:
# las credenciales de AWS salen del perfil o SSO (AWS_PROFILE), no de este archivo.
AWS_PROFILE=
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-east-1

# Recursos de End User Messaging creados a mano (ver scripts/register-rcs-agent.md)
RCS_AGENT_ID=
SMS_ORIGINATION_IDENTITY=
PROTECT_CONFIGURATION_ID=
# Canal de respuesta del inbound-router: rcs (con fallback a SMS) o sms (plan B)
CHANNEL_MODE=rcs

# Modo demo: comprime T-48h y T-24h a minutos
DEMO_MODE=true
DEMO_REMINDER_MINUTES_48H=2
DEMO_REMINDER_MINUTES_24H=4

# Modelo del agente (inference profile de Bedrock; verificar disponibilidad en la region)
AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
